{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "no-var": "error",
    "prefer-const": "warn",
    "no-throw-literal": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "warn",
    "no-unreachable": "error",
    "no-duplicate-case": "error",
    "default-case": "warn",
    "no-alert": "warn",
    "no-console": "off",
    "no-debugger": "warn"
  }
}
